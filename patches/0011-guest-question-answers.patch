@@ -0,0 +1,71 @@
+import { describe, expect, it } from "vite-plus/test";
+
+import { guestAnswersMatchQuestions } from "./guestAnswers.ts";
+
+const single = {
+  id: "style",
+  options: [
+    { label: "Tabs", description: "Tabs", value: "tabs" },
+    { label: "Spaces", description: "Spaces", value: "spaces" },
+  ],
+};
+const multi = {
+  id: "checks",
+  options: [
+    { label: "Typecheck", description: "Typecheck", value: "typecheck" },
+    { label: "Tests", description: "Tests", value: "tests" },
+  ],
+  multiSelect: true,
+};
+
+describe("guestAnswersMatchQuestions", () => {
+  it("accepts an offered option and a question's own text", () => {
+    expect(guestAnswersMatchQuestions([single], { style: "tabs" })).toBe(true);
+    expect(guestAnswersMatchQuestions([single], { style: "Two spaces, please" })).toBe(true);
+  });
+
+  it("accepts several offered options only for a multi-select question", () => {
+    expect(guestAnswersMatchQuestions([multi], { checks: ["typecheck", "tests"] })).toBe(true);
+    expect(guestAnswersMatchQuestions([single], { style: ["tabs", "spaces"] })).toBe(false);
+    expect(guestAnswersMatchQuestions([multi], { checks: [] })).toBe(false);
+    expect(guestAnswersMatchQuestions([multi], { checks: ["tests", "tests"] })).toBe(false);
+    expect(guestAnswersMatchQuestions([multi], { checks: ["deploy"] })).toBe(false);
+  });
+
+  it("refuses a value the question did not offer when custom answers are off", () => {
+    expect(
+      guestAnswersMatchQuestions([{ ...single, allowCustomAnswer: false }], {
+        style: "anything",
+      }),
+    ).toBe(false);
+  });
+
+  it("requires every question and no extra answers", () => {
+    expect(guestAnswersMatchQuestions([single, multi], { style: "tabs" })).toBe(false);
+    expect(
+      guestAnswersMatchQuestions([single], { style: "tabs", extra: "surprise" }),
+    ).toBe(false);
+  });
+
+  it("allows an empty answer only for an optional question without options", () => {
+    const optional = { id: "notes", options: [], required: false };
+    expect(guestAnswersMatchQuestions([optional], { notes: "" })).toBe(true);
+    expect(
+      guestAnswersMatchQuestions([{ ...optional, options: single.options }], { notes: "" }),
+    ).toBe(false);
+  });
+
+  it("accepts an offered empty option and an empty seeded initial answer", () => {
+    const emptyOption = {
+      id: "input",
+      options: [{ label: "Submit empty value", description: "Send empty", value: "" }],
+    };
+    expect(guestAnswersMatchQuestions([emptyOption], { input: "" })).toBe(true);
+
+    const editor = { id: "message", options: [], initialAnswer: "" };
+    expect(guestAnswersMatchQuestions([editor], { message: "" })).toBe(true);
+    expect(
+      guestAnswersMatchQuestions([{ ...editor, allowCustomAnswer: false }], { message: "" }),
+    ).toBe(false);
+  });
+});
diff --git a/apps/server/src/guest/guestAnswers.ts b/apps/server/src/guest/guestAnswers.ts
new file mode 100644
index 0000000000..751c6c3382
--- /dev/null
+++ b/apps/server/src/guest/guestAnswers.ts
@@ -0,0 +1,49 @@
+import type { GuestInputAnswers, OrchestrationV2UserInputQuestion } from "@t3tools/contracts";
+
+type AnswerableQuestion = Pick<
+  OrchestrationV2UserInputQuestion,
+  "id" | "options" | "multiSelect" | "allowCustomAnswer" | "initialAnswer" | "required"
+>;
+
+/**
+ * Whether a guest's answers fit the questions the agent asked: every question answered, no extra
+ * keys, offered options preserved exactly, and custom text only where the question allows it.
+ * The guest page builds answers the same way the owner's composer does; this keeps a hand-written
+ * request from putting arbitrary text or option values in front of the provider.
+ */
+export function guestAnswersMatchQuestions(
+  questions: ReadonlyArray<AnswerableQuestion>,
+  answers: GuestInputAnswers,
+): boolean {
+  const questionIds = new Set(questions.map((question) => question.id));
+  if (Object.keys(answers).length !== questionIds.size) return false;
+
+  for (const question of questions) {
+    if (!Object.hasOwn(answers, question.id)) return false;
+    const answer = answers[question.id];
+    const isOffered = (value: string) =>
+      question.options.some(
+        (option) =>
+          option.value === value || (option.value === undefined && option.label === value),
+      );
+
+    if (Array.isArray(answer)) {
+      if (question.multiSelect !== true || answer.length === 0) return false;
+      if (new Set(answer).size !== answer.length) return false;
+      if (!answer.every((value) => isOffered(value))) return false;
+      continue;
+    }
+    if (typeof answer !== "string") return false;
+    if (isOffered(answer)) continue;
+    if (answer === "") {
+      // The client sends "" for an editor seeded with an empty initial answer, and for an
+      // optional question with no options.
+      if (question.initialAnswer !== undefined && question.allowCustomAnswer !== false) continue;
+      if (question.required === false && question.options.length === 0) continue;
+      return false;
+    }
+    if (question.allowCustomAnswer === false) return false;
+  }
+
+  return true;
+}
