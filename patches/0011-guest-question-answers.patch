diff --git a/apps/web/src/components/guest/GuestQuestionCard.tsx b/apps/web/src/components/guest/GuestQuestionCard.tsx
new file mode 100644
index 0000000000..1940c85f2f
--- /dev/null
+++ b/apps/web/src/components/guest/GuestQuestionCard.tsx
@@ -0,0 +1,246 @@
+import {
+  GUEST_MESSAGE_MAX_LENGTH,
+  GUEST_SHARE_PARAM,
+  type GuestAnswerRequest,
+  type GuestShareView,
+} from "@t3tools/contracts";
+import {
+  buildPendingUserInputAnswers,
+  setPendingUserInputCustomAnswer,
+  togglePendingUserInputOptionSelection,
+  type PendingUserInputDraftAnswer,
+} from "@t3tools/client-runtime/state/pending-user-input";
+import {
+  seedUserInputDraftAnswers,
+  type ThreadPendingUserInput,
+} from "@t3tools/client-runtime/state/thread-requests";
+import { msg, T, useGT, useMessages } from "gt-react";
+import { useState } from "react";
+
+import { cn } from "~/lib/utils";
+import { derivePendingUserInputProgress } from "~/pendingUserInput";
+import { markdownProseDirection, textDirection } from "~/textDirection";
+import ChatMarkdown from "../ChatMarkdown";
+import { Button } from "../ui/button";
+import { postGuest } from "./guestRequests";
+
+/**
+ * The agent's ask-questions prompt, answered as the guest. The owner's composer shows the same
+ * request; whoever answers first resolves it for both. Unlike a guest message, an answer goes
+ * straight to the provider, because the agent is blocked until someone answers.
+ */
+export function GuestQuestionCard({
+  shareId,
+  prompt,
+  onAnswered,
+}: {
+  readonly shareId: GuestShareView["shareId"];
+  readonly prompt: ThreadPendingUserInput;
+  readonly onAnswered: () => void;
+}) {
+  const gt = useGT();
+  const m = useMessages();
+  const [drafts, setDrafts] = useState<Record<string, PendingUserInputDraftAnswer>>(() =>
+    seedUserInputDraftAnswers(prompt.questions, {}),
+  );
+  const [questionIndex, setQuestionIndex] = useState(0);
+  const [sending, setSending] = useState(false);
+  const [answered, setAnswered] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const progress = derivePendingUserInputProgress(prompt.questions, drafts, questionIndex);
+  const question = progress.activeQuestion;
+  const answers = buildPendingUserInputAnswers(prompt.questions, drafts);
+  if (question === null) return null;
+  const isLastQuestion = progress.isLastQuestion;
+  const questionDirection = markdownProseDirection(
+    [
+      question.header,
+      question.question,
+      ...question.options.flatMap((option) => [option.label, option.description ?? ""]),
+    ].join(" "),
+  );
+  const questionTextAlign = questionDirection === "rtl" ? "text-right" : "text-left";
+
+  const selectOption = (optionValue: string) => {
+    if (sending || answered) return;
+    setError(null);
+    setDrafts((current) => ({
+      ...current,
+      [question.id]: togglePendingUserInputOptionSelection(
+        question,
+        current[question.id],
+        optionValue,
+      ),
+    }));
+  };
+  const setCustomAnswer = (customAnswer: string) => {
+    if (sending || answered) return;
+    setError(null);
+    setDrafts((current) => ({
+      ...current,
+      [question.id]: setPendingUserInputCustomAnswer(question, current[question.id], customAnswer),
+    }));
+  };
+  const submit = async () => {
+    if (sending || answered) return;
+    if (!isLastQuestion) {
+      setQuestionIndex(questionIndex + 1);
+      return;
+    }
+    if (answers === null) return;
+    setSending(true);
+    const failure = await postGuest(
+      `answers?${GUEST_SHARE_PARAM}=${encodeURIComponent(shareId)}`,
+      { shareId, requestId: prompt.requestId, answers } satisfies GuestAnswerRequest,
+    );
+    setSending(false);
+    if (failure === null) {
+      setAnswered(true);
+      onAnswered();
+    } else {
+      setError(failure);
+    }
+  };
+
+  return (
+    <section
+      aria-label={gt("Ask a question")}
+      aria-busy={sending}
+      dir={questionDirection}
+      className="mb-2 flex flex-col gap-2 rounded-2xl border border-border bg-card px-4 py-3 shadow-composer dark:shadow-composer-dark"
+    >
+      <div className="flex items-baseline gap-2">
+        <p
+          className="min-w-0 flex-1 truncate text-xs font-medium text-muted-foreground"
+          dir={textDirection(question.header)}
+        >
+          {question.header}
+        </p>
+        {prompt.questions.length > 1 ? (
+          <span className="shrink-0 text-2xs text-muted-foreground tabular-nums">
+            {questionIndex + 1}/{prompt.questions.length}
+          </span>
+        ) : null}
+      </div>
+      <ChatMarkdown
+        text={question.question}
+        cwd={undefined}
+        lineBreaks
+        className={cn(
+          "text-sm text-foreground [&_p:first-child]:mt-0 [&_p:last-child]:mb-0",
+          questionTextAlign,
+        )}
+      />
+      <div
+        role={question.multiSelect ? "group" : "radiogroup"}
+        aria-label={question.header}
+        className="flex flex-col gap-0.5"
+      >
+        {question.options.map((option, index) => {
+          const optionValue = option.value ?? option.label;
+          const selected =
+            progress.customAnswer.trim() === "" &&
+            progress.selectedOptionValues.includes(optionValue);
+          return (
+            <div key={`${question.id}:${index}:${optionValue}`}>
+              <button
+                type="button"
+                role={question.multiSelect ? "checkbox" : "radio"}
+                aria-checked={selected}
+                disabled={sending || answered}
+                onClick={() => selectOption(optionValue)}
+                className={cn(
+                  "flex w-full items-start gap-2.5 rounded-md px-2 py-1.5 text-left outline-none transition-colors duration-150 focus-visible:ring-1 focus-visible:ring-inset focus-visible:ring-primary/25",
+                  selected ? "text-foreground" : "text-foreground/70 hover:bg-muted/30",
+                  (sending || answered) && "cursor-not-allowed opacity-50",
+                )}
+              >
+                <span
+                  aria-hidden
+                  className={cn(
+                    "mt-0.5 flex size-4 shrink-0 items-center justify-center border",
+                    question.multiSelect ? "rounded-sm" : "rounded-full",
+                    selected ? "border-primary bg-primary" : "border-foreground/40",
+                  )}
+                >
+                  {selected ? (
+                    <span
+                      className={cn(
+                        "bg-primary-foreground",
+                        question.multiSelect ? "size-2 rounded-[1px]" : "size-1.5 rounded-full",
+                      )}
+                    />
+                  ) : null}
+                </span>
+                <span className="min-w-0 flex-1">
+                  <span className="block text-sm font-medium" dir={textDirection(option.label)}>
+                    {option.label}
+                  </span>
+                  {option.description && option.description !== option.label ? (
+                    <span
+                      className="block text-xs text-muted-foreground"
+                      dir={textDirection(option.description)}
+                    >
+                      {option.description}
+                    </span>
+                  ) : null}
+                </span>
+              </button>
+              {option.preview ? (
+                <ChatMarkdown
+                  text={option.preview}
+                  cwd={undefined}
+                  lineBreaks
+                  className="ps-8 pe-2 pb-1 text-xs text-foreground/70"
+                />
+              ) : null}
+            </div>
+          );
+        })}
+      </div>
+      {question.allowCustomAnswer === false ? null : (
+        <textarea
+          aria-label={gt("Type your answer")}
+          placeholder={gt("Type your answer")}
+          rows={1}
+          maxLength={GUEST_MESSAGE_MAX_LENGTH}
+          value={progress.customAnswer}
+          dir={questionDirection}
+          disabled={sending || answered}
+          onChange={(event) => setCustomAnswer(event.target.value)}
+          className="min-h-9 w-full resize-none rounded-md border border-border bg-background px-2.5 py-1.5 text-sm outline-none field-sizing-content placeholder:text-placeholder focus-visible:ring-1 focus-visible:ring-inset focus-visible:ring-primary/25 disabled:opacity-50"
+        />
+      )}
+      <div className="flex items-center gap-2">
+        {questionIndex > 0 ? (
+          <Button
+            size="sm"
+            variant="ghost-muted"
+            disabled={sending || answered}
+            onClick={() => setQuestionIndex(questionIndex - 1)}
+          >
+            <T>Back</T>
+          </Button>
+        ) : null}
+        <Button
+          size="sm"
+          disabled={
+            sending || answered || (isLastQuestion ? answers === null : !progress.canAdvance)
+          }
+          onClick={() => void submit()}
+        >
+          {isLastQuestion ? <T>Send</T> : <T>Next</T>}
+        </Button>
+        {answered ? (
+          <p className="text-xs text-muted-foreground">
+            {m(msg("Sent", { $context: "message status" }))}
+          </p>
+        ) : error === null ? null : (
+          <p role="alert" className="min-w-0 flex-1 text-xs text-destructive">
+            {error}
+          </p>
+        )}
+      </div>
+    </section>
+  );
+}
diff --git a/apps/web/src/components/guest/guestRequests.ts b/apps/web/src/components/guest/guestRequests.ts
new file mode 100644
index 0000000000..1ef80d30e9
--- /dev/null
+++ b/apps/web/src/components/guest/guestRequests.ts
@@ -0,0 +1,37 @@
+import { GUEST_ROUTE_PREFIX } from "@t3tools/contracts";
+import * as Option from "effect/Option";
+import * as Schema from "effect/Schema";
+import { msg } from "gt-react";
+
+import { m } from "~/i18n/messages";
+
+export const decodeErrorBody = Schema.decodeUnknownOption(
+  Schema.Struct({ message: Schema.String }),
+);
+
+/** Resolves to null on success, or to a message the guest can read. */
+export async function postGuest(
+  path: "redeem" | `messages?${string}` | `answers?${string}`,
+  body: object | FormData,
+): Promise<string | null> {
+  try {
+    const response = await fetch(
+      `${GUEST_ROUTE_PREFIX}/${path}`,
+      body instanceof FormData
+        ? { method: "POST", body }
+        : {
+            method: "POST",
+            headers: { "content-type": "application/json" },
+            body: JSON.stringify(body),
+          },
+    );
+    if (response.ok) return null;
+    const json: unknown = await response.json().catch(() => null);
+    return Option.match(decodeErrorBody(json), {
+      onNone: () => m(msg("Something went wrong. Try again.")),
+      onSome: ({ message }) => message,
+    });
+  } catch {
+    return m(msg("Could not reach the server."));
+  }
+}
