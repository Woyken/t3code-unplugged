@@ -77,6 +77,19 @@ const SILENT_STREAM_TIMEOUT = "45 seconds";
 const SUBSCRIPTION_TIMEOUT = "10 seconds";
 
 const decodeEvent = Schema.decodeUnknownResult(Schema.fromJsonString(OpenCodeEvent));
+// @opencode/protocol 2.0.28 predates `retryAfterMs`, so the typed event decode
+// drops it. Newer OpenCode servers report a quota reset there, and T3's
+// usage-limit recovery needs the absolute time to resume at.
+const decodeRetryAfterMs = Schema.decodeUnknownOption(
+  Schema.fromJsonString(
+    Schema.Struct({
+      type: Schema.Literal("session.execution.failed"),
+      data: Schema.Struct({
+        error: Schema.Struct({ retryAfterMs: Schema.optionalKey(Schema.Finite) }),
+      }),
+    }),
+  ),
+);
 const decodeEnvelope = Schema.decodeUnknownOption(
   Schema.fromJsonString(
     Schema.Struct({
@@ -129,9 +142,23 @@ const readEvents = HttpClient.get("/api/event", {
       Stream.pipeThroughChannel(Sse.decode()),
       Stream.filterMapEffect((frame) => {
         const decoded = decodeEvent(frame.data);
-        return Result.isSuccess(decoded)
-          ? Effect.succeed(Result.succeed<OpenCode2StreamEvent>(decoded.success))
-          : undecodable(frame.data);
+        if (Result.isFailure(decoded)) return undecodable(frame.data);
+        const event = decoded.success;
+        if (event.type !== "session.execution.failed") {
+          return Effect.succeed(Result.succeed<OpenCode2StreamEvent>(event));
+        }
+        const retryAfterMs =
+          Option.getOrUndefined(decodeRetryAfterMs(frame.data))?.data.error.retryAfterMs;
+        return Effect.succeed(
+          Result.succeed<OpenCode2StreamEvent>(
+            retryAfterMs === undefined
+              ? event
+              : ({
+                  ...event,
+                  data: { ...event.data, error: { ...event.data.error, retryAfterMs } },
+                } as OpenCode2StreamEvent),
+          ),
+        );
       }),
     ),
   ),
