--- /dev/null
+++ b/packages/source-control-azure-devops/src/server/azureDevOpsPullRequestEvents.ts
@@ -0,0 +1,143 @@
+// @effect-diagnostics globalFetch:off globalTimers:off - The native SignalR socket owns its HTTP handshake, abort signal, and deadlines.
+import * as Effect from "effect/Effect";
+import * as Queue from "effect/Queue";
+import * as Stream from "effect/Stream";
+
+import type { AzureDevOpsRepositoryLocation } from "./azureDevOpsPullRequestJson.ts";
+
+const HANDSHAKE_MS = 15_000;
+
+/** Only send the Entra token to Azure DevOps Services, never to links on arbitrary hosts. */
+export function pullRequestEventOrganization(pullRequestUrl: string): string | null {
+  const url = URL.parse(pullRequestUrl);
+  if (url === null || url.protocol !== "https:" || url.port || url.username || url.password) {
+    return null;
+  }
+  if (url.hostname === "dev.azure.com") {
+    const organization = url.pathname.split("/")[1];
+    return organization && /^[a-z\d][a-z\d-]*$/iu.test(organization)
+      ? `${url.origin}/${organization}`
+      : null;
+  }
+  return /^[a-z\d][a-z\d-]*\.visualstudio\.com$/iu.test(url.hostname) ? url.origin : null;
+}
+
+/**
+ * The PR page's private SignalR 1.5 hub. Events only invalidate reads; REST owns the PR state.
+ * End quietly on failure: the watch reactor keeps polling and retries ended feeds on its sweep.
+ */
+export const pullRequestEvents = (input: {
+  readonly organization: string;
+  readonly location: AzureDevOpsRepositoryLocation;
+  readonly number: number;
+  readonly token: string;
+}): Stream.Stream<void> =>
+  Stream.callback<void>(
+    (queue) =>
+      Effect.acquireRelease(
+        Effect.sync(() => {
+          const abort = new AbortController();
+          const headers = { Authorization: `Bearer ${input.token}` };
+          const base = `${input.organization}/_apis/${encodeURIComponent(input.location.project)}/signalr`;
+          let socket: WebSocket | undefined;
+          let timer: ReturnType<typeof setTimeout>;
+          const stop = () => {
+            if (abort.signal.aborted) return;
+            clearTimeout(timer);
+            abort.abort();
+            socket?.close();
+            Queue.endUnsafe(queue);
+          };
+          const expectFrameWithin = (ms: number) => {
+            clearTimeout(timer);
+            timer = setTimeout(stop, ms);
+          };
+          const json = async (url: string) => {
+            const response = await fetch(url, {
+              headers,
+              redirect: "error",
+              signal: abort.signal,
+            });
+            if (!response.ok) throw new Error("Azure DevOps event handshake rejected");
+            const value: unknown = await response.json();
+            if (value === null || typeof value !== "object" || Array.isArray(value)) {
+              throw new Error("Invalid Azure DevOps event handshake response");
+            }
+            return value as Record<string, unknown>;
+          };
+
+          expectFrameWithin(HANDSHAKE_MS);
+          void (async () => {
+            const { instanceId } = await json(`${input.organization}/_apis/connectionData`);
+            if (typeof instanceId !== "string" || !instanceId) return stop();
+            const query = new URLSearchParams({
+              clientProtocol: "1.5",
+              contextToken: instanceId,
+              connectionData: '[{"name":"pullrequestdetailhub"}]',
+            });
+            const { ConnectionToken, KeepAliveTimeout } = await json(`${base}/negotiate?${query}`);
+            if (typeof ConnectionToken !== "string" || !ConnectionToken || abort.signal.aborted) {
+              return stop();
+            }
+            query.set("transport", "webSockets");
+            query.set("connectionToken", ConnectionToken);
+            const keepAliveSec = typeof KeepAliveTimeout === "number" ? KeepAliveTimeout : 0;
+            const silenceMs = Math.min(180_000, Math.max(60_000, keepAliveSec * 1_500));
+            // Node's WebSocket supports upgrade headers; the DOM constructor type omits them.
+            const NodeWebSocket = WebSocket as unknown as new (
+              url: string,
+              options: { headers: Record<string, string> },
+            ) => WebSocket;
+            const connection = new NodeWebSocket(
+              `${base.replace(/^https:/u, "wss:")}/connect?${query}`,
+              {
+                headers,
+              },
+            );
+            socket = connection;
+            let phase: "init" | "start" | "subscribe" | "live" = "init";
+            connection.addEventListener("close", stop, { once: true });
+            connection.addEventListener("error", stop, { once: true });
+            connection.addEventListener("message", (event) => {
+              if (abort.signal.aborted || typeof event.data !== "string") return;
+              try {
+                if (phase === "live") expectFrameWithin(silenceMs);
+                const frame = JSON.parse(event.data);
+                if (frame === null || typeof frame !== "object") return;
+                if (phase === "init" && frame.S === 1) {
+                  phase = "start";
+                  void json(`${base}/start?${query}`)
+                    .then(({ Response }) => {
+                      if (abort.signal.aborted) return;
+                      if (Response !== "started") return stop();
+                      phase = "subscribe";
+                      connection.send(
+                        JSON.stringify({
+                          H: "pullrequestdetailhub",
+                          M: "Subscribe",
+                          A: [input.number, input.location.repository],
+                          I: 0,
+                        }),
+                      );
+                    })
+                    .catch(stop);
+                } else if (phase === "subscribe" && (frame.I === "0" || frame.I === 0)) {
+                  if (frame.E) return stop();
+                  phase = "live";
+                  expectFrameWithin(silenceMs);
+                  // Catch up on anything that happened while connecting or disconnected.
+                  Queue.offerUnsafe(queue, undefined);
+                } else if (phase === "live" && Array.isArray(frame.M) && frame.M.length > 0) {
+                  Queue.offerUnsafe(queue, undefined);
+                }
+              } catch {
+                stop();
+              }
+            });
+          })().catch(stop);
+          return stop;
+        }),
+        (stop) => Effect.sync(stop),
+      ),
+    { bufferSize: 1, strategy: "sliding" },
+  );
