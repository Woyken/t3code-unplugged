@@ -0,0 +1,105 @@
+import * as Effect from "effect/Effect";
+import * as Stream from "effect/Stream";
+import { afterEach, describe, expect, it, vi } from "vite-plus/test";
+
+import { pullRequestEvents, pullRequestEventOrganization } from "./azureDevOpsPullRequestEvents.ts";
+
+const input = {
+  organization: "https://dev.azure.com/example",
+  location: { project: "Project Name", repository: "repo-id" },
+  number: 42,
+  token: "mock-token",
+};
+
+function mockTransport(options: { rejectSubscription?: boolean } = {}) {
+  const request = vi.fn(async (url: string) => {
+    if (url.endsWith("/connectionData")) return Response.json({ instanceId: "instance" });
+    if (url.includes("/negotiate?")) {
+      return Response.json({ ConnectionToken: "connection", KeepAliveTimeout: 45 });
+    }
+    return Response.json({ Response: "started" });
+  });
+  const send = vi.fn();
+  const close = vi.fn();
+  class MockSocket extends EventTarget {
+    constructor(url: string, init: { headers: Record<string, string> }) {
+      super();
+      expect(url).toContain("wss://dev.azure.com/example/_apis/Project%20Name/signalr/connect?");
+      expect(init.headers.Authorization).toBe("Bearer mock-token");
+      queueMicrotask(() => this.frame({ S: 1 }));
+    }
+    frame(data: object) {
+      this.dispatchEvent(new MessageEvent("message", { data: JSON.stringify(data) }));
+    }
+    send(data: string) {
+      send(JSON.parse(data));
+      this.frame({ I: "0", ...(options.rejectSubscription ? { E: "refused" } : {}) });
+      if (options.rejectSubscription) return;
+      // @effect-diagnostics-next-line globalTimers:off - Model a WebSocket message in a later task.
+      setTimeout(() => {
+        this.frame({});
+        this.frame({ M: [] });
+        this.frame({ M: [{ H: "pullrequestdetailhub", M: "OnDiscussionsUpdated" }] });
+        this.dispatchEvent(new Event("close"));
+      }, 0);
+    }
+    close() {
+      close();
+    }
+  }
+  vi.stubGlobal("fetch", request);
+  vi.stubGlobal("WebSocket", MockSocket);
+  return { request, send, close };
+}
+
+afterEach(() => vi.unstubAllGlobals());
+
+describe("Azure DevOps PR events", () => {
+  it("only accepts credential destinations on known Azure DevOps hosts", () => {
+    expect(
+      pullRequestEventOrganization("https://dev.azure.com/org/proj/_git/repo/pullrequest/42"),
+    ).toBe("https://dev.azure.com/org");
+    expect(
+      pullRequestEventOrganization("https://org.visualstudio.com/proj/_git/repo/pullrequest/42"),
+    ).toBe("https://org.visualstudio.com");
+    for (const url of [
+      "https://dev.azure.com.example.com/org/proj",
+      "http://dev.azure.com/org/proj",
+      "https://dev.azure.com:8443/org/proj",
+      "https://user@dev.azure.com/org/proj",
+      "not a URL",
+    ]) {
+      expect(pullRequestEventOrganization(url)).toBeNull();
+    }
+  });
+
+  it("signals once on subscription and once on an event, then closes", async () => {
+    const { request, send, close } = mockTransport();
+    const changes = await Effect.runPromise(Stream.runCollect(pullRequestEvents(input)));
+    expect(changes).toEqual([undefined, undefined]);
+    expect(request).toHaveBeenCalledTimes(3);
+    expect(request).toHaveBeenCalledWith(
+      expect.stringContaining("/negotiate?"),
+      expect.objectContaining({ redirect: "error" }),
+    );
+    expect(send).toHaveBeenCalledWith({
+      H: "pullrequestdetailhub",
+      M: "Subscribe",
+      A: [42, "repo-id"],
+      I: 0,
+    });
+    expect(close).toHaveBeenCalled();
+  });
+
+  it("ends without a signal when the subscription is refused", async () => {
+    const { close } = mockTransport({ rejectSubscription: true });
+    expect(await Effect.runPromise(Stream.runCollect(pullRequestEvents(input)))).toEqual([]);
+    expect(close).toHaveBeenCalled();
+  });
+
+  it("closes the socket when the reader stops", async () => {
+    const { close } = mockTransport();
+    await Effect.runPromise(Stream.runCollect(Stream.take(pullRequestEvents(input), 1)));
+    expect(close).toHaveBeenCalled();
+  });
+});
